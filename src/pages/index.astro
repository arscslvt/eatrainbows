---
import { Button } from "@/components/ui/button";
import MainLayout from "../layouts/Main.layout.astro";
import { Image } from "astro:assets";

import MainRadialBackground from "../assets/backgrounds/radial-blue-orange.jpg";
import MainPagePathStrategy from "../assets/illustrations/textuals/main-page-path-strategy.svg";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
---

<MainLayout>
  <div
    class="flex flex-row h-[calc(100dvh-theme(space.28))] px-6 pt-4 space-x-12"
  >
    <div class="flex flex-1 flex-col justify-end items-start gap-6">
      <div class="space-y-2">
        <div
          class="px-4 h-10 rounded-full border-1 border-[#F54A00] text-lg font-medium w-max flex items-center mesh-3 text-mesh"
        >
          OUR SPECIALITY
        </div>
        <h1 class="font-heading font-medium text-6xl">
          We can see your
          <br />
          <span class="text-mesh mesh-1">dreams</span> and make<br /> it real.
        </h1>
      </div>
      <div class="w-full space-y-3">
        <p class="text-neutral-500 text-lg text-right">
          You’ll get a free mockup.<br />
          Pay it only <span class="italic">if you like it</span>.
        </p>
        <div>
          <Button variant="mesh" className="w-full h-12 mesh-2"
            >Get a Free Consultation</Button
          >
        </div>
      </div>
    </div>
    <div class="flex-1 relative">
      <div
        class="absolute inset-0 w-full h-full rounded-2xl overflow-hidden border border-[#e1dcd5] shadow-lg pointer-events-none select-none"
      >
        <Image
          src={MainRadialBackground}
          alt="Radial Blue Orange Background"
          srcset=""
          class="w-full h-full object-cover pointer-events-none select-none"
        />
      </div>

      <div
        class="absolute inset-0 w-full h-full rounded-2xl overflow-hidden border border-[#e1dcd5] shadow-lg pointer-events-none select-none"
      >
        <Image
          src={MainPagePathStrategy}
          alt="Main Page Path Strategy"
          srcset=""
          class="w-full h-full object-contain pointer-events-none select-none"
        />
      </div>
    </div>
  </div>
</MainLayout>
