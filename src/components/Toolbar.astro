---
import { Button } from "./ui/button";
---

<div
  class="sticky top-0 inset-x-0 z-50 px-6 pt-6 h-[calc(theme(space.16)+theme(space.6))]"
>
  <div class="bg-[#F5F1EE] flex items-center px-4 h-16 rounded-xl">
    <div class="flex flex-1">
      <h2 class="font-normal font-branding">EatRainbows</h2>
    </div>
    <div class="flex space-x-4">
      <Button variant="ghost">Products</Button>
      <Button variant="ghost">Solutions</Button>
      <Button variant="ghost">Us</Button>
      <Button variant="mesh">Tell us your dreams</Button>
    </div>
  </div>
</div>
