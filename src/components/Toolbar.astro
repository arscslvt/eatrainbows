---
import { Button } from "./ui/button";
---

<div
  class="sticky top-0 inset-x-0 z-50 px-6 pt-6 h-[calc(theme(space.16)+theme(space.6))]"
>
  <div
    class="bg-gradient-to-b from-[#F5F1EE]/90 to-[#F5F1EE]/60 backdrop-blur-3xl flex items-center px-4 h-16 rounded-xl"
  >
    <div class="flex flex-1">
      <h2 class="font-normal font-branding">EatRainbows</h2>
    </div>
    <div class="flex gap-4">
      <div class="hidden md:flex gap-4">
        <Button
          variant="ghost"
          className="hover:bg-primary hover:text-primary-foreground"
          >Products</Button
        >
        <Button
          variant="ghost"
          className="hover:bg-primary hover:text-primary-foreground"
          >Solutions</Button
        >
        <Button
          variant="ghost"
          className="hover:bg-primary hover:text-primary-foreground">Us</Button
        >
      </div>
      <Button
        variant="mesh"
        className="hover:bg-primary hover:text-primary-foreground"
        >Tell us your dreams</Button
      >
    </div>
  </div>
</div>
