---
const { className } = Astro.props;
---

<div class={`z-0 h-40 ${className}`}>
  <div
    class="absolute h-full w-full -translate-y-10 rounded-[50%] bg-[#F7BCB1] blur-2xl"
  >
  </div>
  <div
    class="absolute h-full w-full -translate-y-5 rounded-[50%] bg-[#7176FB] blur-2xl"
  >
  </div>
  <div
    class="absolute h-full w-full translate-y-5 rounded-[50%] bg-[#3C7AF6] blur-2xl"
  >
  </div>
  <div
    class="absolute h-2/4 md:h-3/4 w-full translate-y-0 rounded-[50%] bg-[#E33776] blur-2xl z-[10]"
  >
  </div>
  <div
    class="absolute h-full w-full translate-y-15 rounded-[50%] bg-[#3C7AF6] blur-2xl"
  >
  </div>
  <div
    class="absolute h-full w-full -translate-y-20 rounded-[50%] bg-[#7176FB] blur-2xl"
  >
  </div>
</div>
